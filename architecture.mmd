---
title: Prosopo Procaptcha System Architecture
---

graph TB
    %% Synced with the code 2026-09-25. Route list: packages/types/src/provider/api.ts:77-163.
    %% Middleware order: packages/provider/src/api/startProviderApi.ts:257-449. Verify checks, in order:
    %% packages/provider/src/api/verify.ts (maintenance, test site key :176-184, forward :189-202,
    %% client record, dappSignature :230). Auth labels on the edges say what proves who the caller is.
    %% ===== ACTORS =====
    Developer["Website Developer<br/>(integrates Procaptcha)"]
    EndUser["End User<br/>(website visitor)"]

    %% ===== CLIENT SIDE =====
    subgraph Browser["End User Browser"]
        direction TB
        Widget["Procaptcha Widget<br/>procaptcha-react / procaptcha-bundle"]
        Manager["Manager<br/>(procaptcha)"]
        LB["Load Balancer<br/>(load-balancer)"]

        subgraph Detection["Bot Detection"]
            Detector["Detector<br/>(detector)"]
            Fingerprint["Fingerprint<br/>(fingerprint)"]
            Behavioral["Behavioral Collectors<br/>mouse / touch / keyboard"]
        end

        subgraph CaptchaFlows["Challenge Flows"]
            Frictionless["Frictionless<br/>(procaptcha-frictionless)"]
            ImageCaptcha["Image Captcha<br/>select matching images"]
            PoW["Proof of Work<br/>compute hash puzzle"]
            PuzzleCaptcha["Puzzle Captcha<br/>drag the piece into the notch"]
        end
    end

    %% ===== PROVIDER =====
    subgraph Provider["Prosopo Provider"]
        direction TB
        subgraph PublicAPI["Public API"]
            Healthz["GET /healthz"]
            Details["GET .../public/details"]
            MetricsEP["GET /metrics<br/>(no auth; on unless<br/>PROSOPO_METRICS_ENABLED=false)"]
        end

        Middleware["Middleware chain, in order:<br/>cors, body parsers (json 1mb),<br/>public router, rate limits (keyed on<br/>IP, unverified JWT user or site-key header),<br/>request logger, ja4, ipInfo,<br/>headerCheck (Prosopo-User / Site-Key<br/>present and well formed: NOT auth),<br/>verify router (before block),<br/>admin + UAP JWT auth, blockMiddleware,<br/>domainMiddleware (client routes)"]

        subgraph ClientAPI["Client API (unauthenticated: Site Key header is an identifier, not a credential)"]
            direction TB
            FrictionlessEP["POST .../client/captcha/frictionless"]
            ImageChallengeEP["POST .../client/captcha/image"]
            ImageSolutionEP["POST .../client/solution"]
            PowChallengeEP["POST .../client/captcha/pow"]
            PowSolutionEP["POST .../client/pow/solution"]
            PuzzleChallengeEP["POST .../client/captcha/puzzle"]
            PuzzleSolutionEP["POST .../client/puzzle/solution"]
            ImageVerifyEP["POST .../client/image/dapp/verify"]
            PowVerifyEP["POST .../client/pow/verify"]
            PuzzleVerifyEP["POST .../client/puzzle/verify"]
            AuthVerifyEP["POST .../client/authenticated/verify<br/>(authenticated frictionless session)"]
            UnroutedEP["declared, no handler:<br/>.../client/status, .../client/events"]
            SpamEmailEP["POST .../client/spam/email"]
            DetectorAssignEP["POST .../client/detector/assign<br/>(assigns this session a pool bundle)"]
        end

        subgraph AdminAPI["Admin API (requires JWT)"]
            SiteKeyMgmt["Site Key Management<br/>sitekey + sitekeys (batch)<br/>register / remove"]
            SessionGetEP["POST .../admin/session/get"]
            CountersClearEP["POST .../admin/counters/clear-all"]
            DetectorPoolMgmt["Detector Pool Replace<br/>(hot-swaps the in-memory pool)"]
            DecisionMachineMgmt["Decision Machine Management<br/>update / get / get-all /<br/>remove / remove-all"]
            MaintenanceToggle["Maintenance Mode Toggle"]
            DnsEventEP["POST .../admin/dns/event<br/>(receives DNS event batches from the dns sidecar)"]
        end

        subgraph UapAPI["User Access Policy API (requires JWT)"]
            RulesCRUD["Access Rules CRUD<br/>insert / fetch / delete / rehash"]
        end

        subgraph ProviderLogic["Provider Logic"]
            ImgTasks["Image Captcha Manager"]
            PowTasks["PoW Captcha Manager"]
            PuzzleTasks["Puzzle Captcha Manager"]
            FrictionlessTasks["Frictionless Manager"]
            DetectorPool["Detector Bundle Pool<br/>(precomputed bundles loaded<br/>from disk; empty pool ⇒ no<br/>detection ⇒ PoW fallback)"]
            SolutionVerifier["Solution Verifier<br/>Merkle tree + salt embedding"]
            DecisionMachine["Decision Machine<br/>pluggable scoring +<br/>post-pow escalation"]
            AccessPolicies["Access Policies<br/>(UAP: per-IP/ja4/headHash<br/>rules; can set captchaType +<br/>params; deferToVerify;<br/>Block messageKey → 403 reason)"]
            TrafficFilter["Traffic Filter<br/>(site-wide: per-category<br/>vpn / proxy / tor / abuser /<br/>datacenter / mobile /<br/>satellite / crawler)<br/>action = block | challenge"]
            SpamFilter["Spam Filter<br/>(email rules)"]
            WebBotAuth["Web Bot Auth<br/>(signed-agent check in frictionless;<br/>fetches the agent's JWKS URL)"]
        end

        subgraph Storage["Storage"]
            MongoDB[(MongoDB<br/>captchas, commitments,<br/>clients, sessions)]
            Redis[(Redis<br/>session cache,<br/>write queue)]
            Dataset[(Dataset<br/>labelled + unlabelled<br/>captcha images)]
        end
    end

    %% ===== WEBSITE BACKEND =====
    subgraph DappBackend["Website Backend"]
        ServerPkg["ProsopoServer<br/>(@prosopo/server)"]
    end

    %% ===== EXTERNAL =====
    ProviderList["Provider List<br/>provider-list.prosopo.io"]

    %% ===== DNS SIDECAR =====
    subgraph DnsEventSidecar["DNS Sidecar (prosopo/dns, per pronode)"]
        direction TB
        DnsAuth["Authoritative DNS<br/>(UDP+TCP 53, *.{subzone})"]
        DnsPixel["HTTPS Pixel<br/>(internal 9362, fronted by Caddy)"]
    end

    Widget -->|"no-cors GET dns_url"| DnsPixel
    DnsAuth -.->|"DNS event"| DnsEventEP
    DnsPixel -.->|"HTTP event"| DnsEventEP

    %% ===== DEVELOPER FLOW =====
    Developer -->|"1. Sign up at prosopo.io<br/>get site key + secret"| DappBackend
    Developer -->|"2. Add widget to frontend<br/>with site key<br/>(optional data-sessionid →<br/>clientMetaData.clientSessionId)"| Widget

    %% ===== USER FLOW =====
    EndUser -->|visits website| Widget
    Widget --> Manager
    Manager -->|fetch provider list| LB
    LB -->|weighted random selection| ProviderList
    ProviderList -->|provider URLs + weights| LB

    %% ===== FRICTIONLESS FLOW =====
    Manager -->|default: frictionless| Frictionless
    Frictionless -->|parallel| Detector
    Frictionless -->|parallel| Fingerprint
    Frictionless -->|parallel| Behavioral
    Frictionless -->|request session| FrictionlessEP

    FrictionlessEP --> FrictionlessTasks
    FrictionlessTasks -->|"session dedup,<br/>honeypot"| Redis
    FrictionlessTasks -->|"verifyWebBotAuth"| WebBotAuth
    WebBotAuth -.->|"fetch JWKS<br/>(no timeout)"| AgentJwks["Agent JWKS host<br/>(external, caller-named)"]
    FrictionlessTasks --> Redis
    FrictionlessTasks -->|"1. handleAccessPolicy<br/>(captchaType override)"| AccessPolicies
    FrictionlessTasks -->|"2. handleFrictionlessTrafficFilter<br/>(block → 401, challenge →<br/>dispatch send{Image,Pow,Puzzle})"| TrafficFilter
    FrictionlessTasks -->|"3. runDecisionMachine<br/>(score-based routing)"| DecisionMachine
    FrictionlessTasks -->|human detected| Manager
    FrictionlessTasks -->|bot suspected| ImageCaptcha
    FrictionlessTasks -->|bot suspected| PoW
    FrictionlessTasks -->|"middle band of the<br/>score ladder"| PuzzleCaptcha

    %% ===== DETECTOR POOL =====
    %% The detector ships ONLY as a provider-served pool bundle — there is no
    %% detector in the widget bundle. The browser is assigned one per session
    %% and the provider decrypts its output with that bundle's key.
    Detector -->|request a bundle| DetectorAssignEP
    DetectorAssignEP --> DetectorPool
    DetectorPool -->|"per-session bundle + key"| Detector
    DetectorPoolMgmt -.->|replace in memory| DetectorPool
    FrictionlessTasks -->|"decrypt detector output<br/>with the assigned bundle's key"| DetectorPool

    %% ===== IMAGE CAPTCHA FLOW =====
    Manager -->|fallback: image| ImageCaptcha
    ImageCaptcha -->|get challenge| ImageChallengeEP
    ImageChallengeEP -->|"1. AccessPolicy lookup<br/>(deferToVerify filtered)"| AccessPolicies
    ImageChallengeEP -->|"2. applyTrafficFilterAtRequestTime<br/>(block → 401,<br/>challenge → solvedImagesCount override)"| TrafficFilter
    ImageChallengeEP --> ImgTasks
    ImgTasks -->|"random captchas + salt<br/>solvedImagesCount cascade:<br/>trafficFilter → session →<br/>AccessPolicy → siteSettings"| Dataset
    ImgTasks -->|signed challenge| ImageCaptcha
    ImageCaptcha -->|user selects images| ImageSolutionEP
    ImageSolutionEP --> SolutionVerifier
    SolutionVerifier -->|compare solutions| Dataset
    SolutionVerifier -->|build commitment| MongoDB
    SolutionVerifier -->|optional scoring| DecisionMachine
    SolutionVerifier -->|"resolveTrafficFilterCheck<br/>(block matches → disapprove)"| TrafficFilter
    SolutionVerifier -->|"checkForHardBlock +<br/>deferToVerify block →<br/>ACCESS_POLICY_BLOCK"| AccessPolicies
    SolutionVerifier -->|signed token| Manager

    %% ===== POW FLOW =====
    Manager -->|fallback: pow| PoW
    PoW -->|get challenge| PowChallengeEP
    PowChallengeEP -->|"1. AccessPolicy lookup"| AccessPolicies
    PowChallengeEP -->|"2. applyTrafficFilterAtRequestTime<br/>(block → 401,<br/>challenge → powDifficulty override)"| TrafficFilter
    PowChallengeEP --> PowTasks
    PowTasks -->|"challenge + difficulty<br/>(cascade: trafficFilter → session →<br/>AccessPolicy → siteSettings)"| PoW
    PoW -->|"computed proof<br/>+ behavioural data"| PowSolutionEP
    PowSolutionEP --> PowTasks
    PowTasks -->|verify proof| MongoDB
    PowTasks -->|"resolveTrafficFilterCheck<br/>(block matches → disapprove)"| TrafficFilter
    PowTasks -->|"checkForHardBlock +<br/>deferToVerify block"| AccessPolicies
    PowTasks -->|"post-pow routing<br/>(re-evaluate with<br/>behavioural data)"| DecisionMachine
    PowTasks -->|signed token| Manager
    PowTasks -->|escalate: image/puzzle<br/>+ new sessionId| PoW
    PoW -->|escalation handoff| ImageCaptcha
    PoW -->|escalation handoff| PuzzleCaptcha

    %% ===== PUZZLE FLOW =====
    Manager -->|fallback: puzzle| PuzzleCaptcha
    PuzzleCaptcha -->|get challenge| PuzzleChallengeEP
    PuzzleChallengeEP -->|"1. AccessPolicy lookup"| AccessPolicies
    PuzzleChallengeEP -->|"2. applyTrafficFilterAtRequestTime<br/>(challenge → puzzleTolerance +<br/>render overrides; block is NOT a 401<br/>here — it is enforced at submit/verify<br/>so the user still gets a captcha)"| TrafficFilter
    PuzzleChallengeEP --> PuzzleTasks
    PuzzleTasks -->|"background + notch placement<br/>(tolerance cascade: trafficFilter →<br/>session → siteSettings)"| PuzzleCaptcha
    PuzzleCaptcha -->|"dropped piece position<br/>+ behavioural data"| PuzzleSolutionEP
    PuzzleSolutionEP --> PuzzleTasks
    PuzzleTasks -->|verify placement| MongoDB
    PuzzleTasks -->|"resolveTrafficFilterCheck<br/>(block matches → disapprove)"| TrafficFilter
    PuzzleTasks -->|"checkForHardBlock +<br/>deferToVerify block"| AccessPolicies
    PuzzleTasks -->|signed token| Manager

    %% ===== TOKEN TO BACKEND =====
    Manager -->|"ProcaptchaToken<br/>(hex-encoded)"| EndUser
    EndUser -->|"submit form + token"| DappBackend

    %% ===== SERVER VERIFICATION =====
    DappBackend --> ServerPkg
    ServerPkg -->|"verify image token<br/>(+ optional clientSessionId)"| ImageVerifyEP
    ServerPkg -->|"verify pow token<br/>(+ optional clientSessionId)"| PowVerifyEP
    ServerPkg -->|"verify puzzle token<br/>(+ optional clientSessionId)"| PuzzleVerifyEP
    ServerPkg -->|"verify authenticated session"| AuthVerifyEP
    VerifyChecks["Verify handler checks, in order:<br/>1. maintenance mode: verified true (fail open)<br/>2. test site key: fixed verdict<br/>3. token issued by another provider:<br/>forward to it (allowlisted provider list),<br/>BEFORE the signature check<br/>4. client record exists<br/>5. dappSignature over the token<br/>timestamp, by the site key"]
    ImageVerifyEP --- VerifyChecks
    PowVerifyEP --- VerifyChecks
    PuzzleVerifyEP --- VerifyChecks
    VerifyChecks -.->|"forward verify"| OtherProvider["Issuing provider<br/>(from provider list)"]
    ImageVerifyEP -->|decode token, check commitment| MongoDB
    PowVerifyEP -->|decode token, check proof| MongoDB
    PuzzleVerifyEP -->|decode token, check placement| MongoDB
    ImageVerifyEP -->|"verified: true/false"| ServerPkg
    PowVerifyEP -->|"verified: true/false"| ServerPkg
    PuzzleVerifyEP -->|"verified: true/false"| ServerPkg
    ServerPkg -->|grant or deny access| DappBackend

    %% ===== ADMIN =====
    Developer -.->|"manage via portal<br/>or admin API<br/>(sr25519 JWT, authMiddleware)"| AdminAPI
    Developer -.->|"sr25519 JWT"| UapAPI
    Scraper["Metrics scraper / anyone"] -->|"no auth"| MetricsEP
    AdminAPI --> MongoDB

    %% ===== STORAGE CONNECTIONS =====
    ImgTasks --> MongoDB
    PowTasks --> MongoDB
    FrictionlessTasks --> MongoDB
    AccessPolicies --> Redis
    AuthVerifyEP --> MongoDB
    TrafficFilter -.->|"loaded from<br/>clientRecord.settings"| MongoDB
    SpamFilter -.->|"loaded from<br/>clientRecord.settings"| MongoDB
    DecisionMachine --> MongoDB
    ImgTasks --> Redis
    Middleware -.->|"gates"| ClientAPI
    Middleware -.->|"gates"| AdminAPI
    PowTasks --> Redis

    %% ===== STYLES =====
