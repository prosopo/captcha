    class ImgTasks,PowTasks,PuzzleTasks,FrictionlessTasks,SolutionVerifier,DecisionMachine,DetectorPool,AccessPolicies,TrafficFilter,SpamFilter,WebBotAuth provider
    class MongoDB,Redis,Dataset storage
    class ServerPkg,DappBackend backend
