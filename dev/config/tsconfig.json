{
	"extends": "../../tsconfig.esm.json",
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./dist/tsc",
		"tsBuildInfoFile": "./dist/tsc/tsconfig.tsbuildinfo",
		"types": ["vite/client"]
	},
	"include": [
		"./src/**/*.ts",
		"./src/**/*.d.ts",
		"./src/**/*.tsx",
		"src/**/*.ts",
		"src/**/*.tsx",
		"src/**/*.json",
		"src/**/*.d.ts"
	]
}
