{
	"extends": ["//"],
	"tasks": {
		"build:esm": {
			"dependsOn": ["^build:esm"],
			"outputs": ["dist/esm/**"]
		},
		"build:cjs": {
			"dependsOn": ["^build:cjs"],
			"outputs": ["dist/cjs/**"]
		},
		"bundle": {
			"outputs": ["dist/bundle/**"]
		},
		"bundle:webpack": {
			"outputs": ["dist/bundle-webpack/**"]
		},
		"test": {}
	}
}
