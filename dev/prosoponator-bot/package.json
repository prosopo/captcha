{
	"name": "@prosopo/prosoponator-bot",
	"version": "2.6.29",
	"description": "",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "npm run build:cross-env -- --mode ${NODE_ENV:-development}",
		"build:cross-env": "vite build --config vite.esm.config.ts",
		"build:tsc": "tsc --build --verbose",
		"build:cjs": "NODE_ENV=${NODE_ENV:-development}; vite build --config vite.cjs.config.ts --mode $NODE_ENV",
		"typecheck": "tsc --project tsconfig.types.json",
		"start": "npx tsx src/index.ts",
		"test": "NODE_ENV=${NODE_ENV:-test}; npx vitest run --config ./vite.test.config.ts",
		"test:watch": "NODE_ENV=${NODE_ENV:-test}; npx vitest --config ./vite.test.config.ts",
		"test:coverage": "NODE_ENV=${NODE_ENV:-test}; npx vitest run --coverage --config ./vite.test.config.ts"
	},
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@actions/core": "3.0.1",
		"@actions/github": "9.1.1",
		"undici": "6.28.0"
	},
	"devDependencies": {
		"@prosopo/config": "3.3.13",
		"@types/node": "22.10.2",
		"@vitest/coverage-v8": "4.1.11",
		"concurrently": "9.0.1",
		"del-cli": "6.0.0",
		"dotenv": "16.4.7",
		"npm-run-all": "4.1.5",
		"tslib": "2.7.0",
		"tsx": "4.20.3",
		"typescript": "5.6.2",
		"vite": "8.1.5",
		"vitest": "4.1.11"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/cjs/index.cjs",
			"types": "./dist/index.d.ts"
		}
	},
	"engines": {
		"node": "^24",
		"npm": "^11"
	}
}
