{
	"name": "@prosopo/prosoponator-bot",
	"version": "2.6.31",
	"description": "",
	"private": true,
	"type": "module",
	"scripts": {
		"build:esm": "vite build --config vite.esm.config.ts --mode ${NODE_ENV:-development}",
		"build:tsc": "tsc --build --verbose",
		"build:cjs": "NODE_ENV=${NODE_ENV:-development}; vite build --config vite.cjs.config.ts --mode $NODE_ENV",
		"build:types": "tsc --project tsconfig.types.json",
		"start": "pnpm exec tsx src/index.ts",
		"test": "NODE_ENV=${NODE_ENV:-test}; pnpm exec vitest run --config ./vite.test.config.ts",
		"test:watch": "NODE_ENV=${NODE_ENV:-test}; pnpm exec vitest --config ./vite.test.config.ts",
		"test:coverage": "NODE_ENV=${NODE_ENV:-test}; pnpm exec vitest run --coverage --config ./vite.test.config.ts"
	},
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@actions/core": "3.0.1",
		"@actions/github": "9.1.1",
		"undici": "8.12.0"
	},
	"devDependencies": {
		"@prosopo/config": "workspace:*",
		"@types/node": "22.10.2",
		"@vitest/coverage-v8": "5.0.4",
		"concurrently": "9.0.1",
		"del-cli": "6.0.0",
		"dotenv": "18.0.7",
		"npm-run-all": "4.1.5",
		"tslib": "2.7.0",
		"tsx": "4.20.3",
		"typescript": "5.6.2",
		"vite": "8.1.6",
		"vitest": "5.0.4"
	},
	"main": "dist/esm/index.js",
	"types": "dist/types/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/esm/index.js",
			"require": "./dist/cjs/index.cjs",
			"types": "./dist/types/index.d.ts"
		}
	},
	"engines": {
		"node": "^24"
	}
}
