{
	"name": "@prosopo/native-ja4",
	"version": "0.0.1",
	"description": "Rust JA4 TLS fingerprint parser exposed to Node via napi-rs.",
	"license": "Apache-2.0",
	"private": true,
	"main": "index.js",
	"types": "index.d.ts",
	"files": [
		"index.js",
		"index.d.ts",
		"*.node"
	],
	"engines": {
		"node": "^24"
	},
	"napi": {
		"binaryName": "prosopo-native-ja4",
		"targets": [
			"x86_64-unknown-linux-gnu"
		]
	},
	"scripts": {
		"build": "napi build --platform --release",
		"build:debug": "napi build --platform",
		"test:cargo": "cargo test --release",
		"test": "npm run test:cargo",
		"clean": "cargo clean && rm -f *.node index.js index.d.ts"
	},
	"devDependencies": {
		"@napi-rs/cli": "^2.18.4"
	}
}
