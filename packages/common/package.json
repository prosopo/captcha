{
	"name": "@prosopo/common",
	"version": "3.3.0",
	"description": "Prosopo common library",
	"main": "dist/esm/index.js",
	"types": "dist/types/index.d.ts",
	"type": "module",
	"engines": {
		"node": "^24"
	},
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/esm/index.js",
			"require": "./dist/cjs/index.cjs"
		},
		"./utils": {
			"types": "./dist/types/utils/.export.d.ts",
			"import": "./dist/esm/utils/.export.js",
			"require": "./dist/cjs/utils/.export.cjs"
		}
	},
	"scripts": {
		"clean": "del-cli --verbose dist",
		"build:esm": "vite build --config vite.esm.config.ts --mode ${NODE_ENV:-development}",
		"build:tsc": "tsc --build --verbose",
		"build:cjs": "NODE_ENV=${NODE_ENV:-development}; vite build --config vite.cjs.config.ts --mode $NODE_ENV",
		"build:types": "tsc --project tsconfig.types.json",
		"test": "NODE_ENV=${NODE_ENV:-test}; pnpm exec vitest run --config ./vite.test.config.ts"
	},
	"author": "Prosopo Limited",
	"license": "Apache-2.0",
	"devDependencies": {
		"@prosopo/config": "workspace:*",
		"@types/node": "22.10.2",
		"@prosopo/types": "workspace:*",
		"@vitest/coverage-v8": "5.0.4",
		"concurrently": "9.0.1",
		"del-cli": "6.0.0",
		"dotenv": "18.0.8",
		"npm-run-all": "4.1.5",
		"tslib": "2.7.0",
		"tsx": "4.20.3",
		"typescript": "5.6.2",
		"vite": "8.1.6",
		"vitest": "5.0.4"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/prosopo/captcha.git",
		"directory": "packages/common"
	},
	"bugs": {
		"url": "https://github.com/prosopo/captcha/issues"
	},
	"homepage": "https://github.com/prosopo/captcha#readme",
	"publishConfig": {
		"registry": "https://registry.npmjs.org"
	},
	"sideEffects": false
}
