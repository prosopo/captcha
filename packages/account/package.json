{
	"name": "@prosopo/account",
	"version": "2.8.116",
	"description": "Services and Utils for Prosopo account gen and management",
	"main": "dist/esm/index.js",
	"types": "dist/types/index.d.ts",
	"type": "module",
	"engines": {
		"node": "^24"
	},
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/esm/index.js",
			"require": "./dist/cjs/index.cjs"
		},
		"./extension/ExtensionWeb2": {
			"types": "./dist/types/extension/ExtensionWeb2.d.ts",
			"import": "./dist/esm/extension/ExtensionWeb2.js",
			"require": "./dist/cjs/extension/ExtensionWeb2.cjs",
			"default": "./dist/esm/extension/ExtensionWeb2.js"
		},
		"./extension/ExtensionWeb3": {
			"types": "./dist/types/extension/ExtensionWeb3.d.ts",
			"import": "./dist/esm/extension/ExtensionWeb3.js",
			"require": "./dist/cjs/extension/ExtensionWeb3.cjs",
			"default": "./dist/esm/extension/ExtensionWeb3.js"
		}
	},
	"scripts": {
		"clean": "del-cli --verbose dist",
		"build:esm": "vite build --config vite.esm.config.ts --mode ${NODE_ENV:-development}",
		"build:tsc": "tsc --build --verbose",
		"build:cjs": "NODE_ENV=${NODE_ENV:-development}; vite build --config vite.cjs.config.ts --mode $NODE_ENV",
		"test": "NODE_ENV=${NODE_ENV:-test}; pnpm exec vitest run --config ./vite.test.config.ts",
		"build:types": "tsc --project tsconfig.types.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/prosopo/captcha.git",
		"directory": "packages/account"
	},
	"author": "Prosopo Limited",
	"license": "Apache-2.0",
	"bugs": {
		"url": "https://github.com/prosopo/captcha/issues"
	},
	"homepage": "https://github.com/prosopo/captcha#readme",
	"dependencies": {
		"@polkadot/extension-base": "0.64.1",
		"@polkadot/extension-dapp": "0.64.1",
		"@polkadot/extension-inject": "0.64.1",
		"@polkadot/util": "14.0.3",
		"@polkadot/util-crypto": "14.0.3",
		"@prosopo/common": "workspace:*",
		"@prosopo/fingerprint": "workspace:*",
		"@prosopo/keyring": "workspace:*",
		"@prosopo/types": "workspace:*",
		"@prosopo/util": "workspace:*",
		"@prosopo/util-crypto": "workspace:*"
	},
	"devDependencies": {
		"@prosopo/config": "workspace:*",
		"@types/node": "22.10.2",
		"@vitest/coverage-v8": "5.0.4",
		"concurrently": "9.0.1",
		"del-cli": "6.0.0",
		"dotenv": "18.0.8",
		"npm-run-all": "4.1.5",
		"tslib": "2.7.0",
		"tsx": "4.20.3",
		"typescript": "5.6.2",
		"vite": "8.1.6",
		"vitest": "5.0.4"
	},
	"sideEffects": false
}
