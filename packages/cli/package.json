{
	"name": "@prosopo/cli",
	"version": "3.8.26",
	"description": "CLI for Prosopo Provider",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"type": "module",
	"engines": {
		"node": "^24"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/cjs/index.cjs"
		}
	},
	"scripts": {
		"clean": "del-cli --verbose dist tsconfig.tsbuildinfo",
		"build": "pnpm run build:cross-env --mode ${NODE_ENV:-development}",
		"build:cross-env": "vite build --config vite.esm.config.ts",
		"build:tsc": "tsc --build --verbose",
		"build:cjs": "NODE_ENV=${NODE_ENV:-development}; vite build --config vite.cjs.config.ts --mode $NODE_ENV",
		"docker-tag": "node ../../docker/docker-tag.mjs",
		"build:docker": "docker buildx build --progress=plain --tag $(pnpm run --silent docker-tag) --platform linux/amd64 -f ./Dockerfile ../..",
		"publish:docker": "docker push $(pnpm run --silent docker-tag)",
		"typecheck": "tsc --project tsconfig.types.json",
		"test": "NODE_ENV=${NODE_ENV:-test}; pnpm exec vitest run --config ./vite.test.config.ts",
		"bundle": "NODE_ENV=${NODE_ENV:-development}; vite build --config vite.config.ts --mode $NODE_ENV",
		"cli": "node ./dist/cli.js",
		"start": "node ./dist/cli.js --api",
		"start:admin": "node ./dist/cli.js --api --adminApi",
		"start:dev": "node ./dist/cli.js --api --dev"
	},
	"dependencies": {
		"@polkadot/types-codec": "16.5.6",
		"@prosopo/api": "workspace:*",
		"@prosopo/common": "workspace:*",
		"@prosopo/logger": "workspace:*",
		"@prosopo/dotenv": "workspace:*",
		"@prosopo/env": "workspace:*",
		"@prosopo/keyring": "workspace:*",
		"@prosopo/locale": "workspace:*",
		"@prosopo/provider": "workspace:*",
		"@prosopo/types": "workspace:*",
		"@prosopo/util": "workspace:*",
		"@prosopo/workspace": "workspace:*",
		"cron-parser": "5.10.0",
		"dotenv": "16.4.5",
		"yargs": "18.1.0",
		"zod": "3.23.8"
	},
	"devDependencies": {
		"@polkadot-api/substrate-client": "0.7.0",
		"@prosopo/config": "workspace:*",
		"@types/cors": "2.8.19",
		"@types/express": "4.17.25",
		"@types/node": "22.10.2",
		"@types/yargs": "17.0.35",
		"@vitest/coverage-v8": "4.1.11",
		"concurrently": "9.0.1",
		"del-cli": "6.0.0",
		"express": "4.22.2",
		"npm-run-all": "4.1.5",
		"smoldot": "2.0.26",
		"tslib": "2.7.0",
		"tsx": "4.20.3",
		"typescript": "5.6.2",
		"vite": "8.1.5",
		"vitest": "4.1.11"
	},
	"author": "Prosopo",
	"license": "Apache-2.0",
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/prosopo/captcha.git",
		"directory": "packages/cli"
	},
	"prosopo": {
		"dockerImage": "prosopo/provider"
	}
}
