{
	"name": "@prosopo/native-merkle",
	"version": "0.0.4",
	"description": "Rust merkle tree + blake2b hashing helpers for the Prosopo captcha provider (napi-rs).",
	"license": "Apache-2.0",
	"author": "Prosopo Limited",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/prosopo/captcha.git",
		"directory": "packages/native-merkle"
	},
	"main": "index.js",
	"types": "index.d.ts",
	"files": ["index.js", "index.d.ts", "*.node"],
	"engines": {
		"node": "^24",
		"npm": "^11"
	},
	"napi": {
		"binaryName": "prosopo-native-merkle",
		"targets": ["x86_64-unknown-linux-gnu"]
	},
	"scripts": {
		"build": "napi build --platform --release",
		"build:debug": "napi build --platform",
		"test:cargo": "cargo test --release",
		"clean": "cargo clean && rm -f *.node index.js index.d.ts"
	},
	"devDependencies": {
		"@napi-rs/cli": "3.8.6"
	}
}
