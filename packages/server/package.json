{
	"name": "@prosopo/server",
	"version": "2.14.1",
	"description": "NodeJS package for server side communication with the prosopo captcha client",
	"main": "dist/esm/index.js",
	"types": "dist/types/index.d.ts",
	"type": "module",
	"engines": {
		"node": "^24"
	},
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/esm/index.js",
			"require": "./dist/cjs/index.cjs"
		}
	},
	"scripts": {
		"clean": "del-cli --verbose dist",
		"build:esm": "vite build --config vite.esm.config.ts --mode ${NODE_ENV:-development}",
		"build:tsc": "tsc --build --verbose",
		"build:cjs": "NODE_ENV=${NODE_ENV:-development}; vite build --config vite.cjs.config.ts --mode $NODE_ENV",
		"build:types": "tsc --project tsconfig.types.json",
		"test": "NODE_ENV=${NODE_ENV:-test}; pnpm exec vitest run --config ./vite.test.config.ts"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/prosopo/captcha.git",
		"directory": "packages/server"
	},
	"author": "PROSOPO LIMITED",
	"license": "Apache-2.0",
	"bugs": {
		"url": "https://github.com/prosopo/captcha/issues"
	},
	"homepage": "https://github.com/prosopo/captcha#readme",
	"sideEffects": false,
	"dependencies": {
		"@prosopo/api": "workspace:*",
		"@prosopo/common": "workspace:*",
		"@prosopo/logger": "workspace:*",
		"@prosopo/keyring": "workspace:*",
		"@prosopo/locale": "workspace:*",
		"@prosopo/load-balancer": "workspace:*",
		"@prosopo/types": "workspace:*",
		"@prosopo/util": "workspace:*",
		"i18next": "26.5.2"
	},
	"devDependencies": {
		"@polkadot/util": "14.0.3",
		"@prosopo/config": "workspace:*",
		"@types/node": "22.10.2",
		"@vitest/coverage-v8": "5.0.4",
		"concurrently": "9.0.1",
		"del-cli": "6.0.0",
		"npm-run-all": "4.1.5",
		"tslib": "2.7.0",
		"tsx": "4.20.3",
		"typescript": "5.6.2",
		"vite": "8.1.6",
		"vitest": "5.0.4",
		"zod": "3.25.76"
	}
}
