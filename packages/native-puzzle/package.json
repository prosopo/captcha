{
	"name": "@prosopo/native-puzzle",
	"version": "0.1.4",
	"description": "Rust puzzle background synthesis for the Prosopo captcha provider (napi-rs).",
	"license": "Apache-2.0",
	"author": "Prosopo Limited",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/prosopo/captcha.git",
		"directory": "packages/native-puzzle"
	},
	"main": "index.js",
	"types": "index.d.ts",
	"files": ["index.js", "index.d.ts", "*.node"],
	"engines": {
		"node": "^24"
	},
	"napi": {
		"binaryName": "index",
		"targets": ["x86_64-unknown-linux-gnu"]
	},
	"scripts": {
		"build": "if [ \"$NODE_ENV\" = production ]; then pnpm run build:release; else pnpm run build:debug; fi",
		"build:debug": "napi build --platform",
		"build:release": "napi build --platform --release",
		"bench": "pnpm run build:release && node bench.mjs",
		"test:cargo": "cargo test",
		"test": "node --test tests/dimensions.test.ts",
		"clean": "cargo clean && rm -f *.node"
	},
	"devDependencies": {
		"@napi-rs/cli": "3.10.8"
	}
}
