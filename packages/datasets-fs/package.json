{
	"name": "@prosopo/datasets-fs",
	"version": "3.0.153",
	"author": "PROSOPO LIMITED <info@prosopo.io>",
	"license": "Apache-2.0",
	"private": false,
	"engines": {
		"node": "^24"
	},
	"scripts": {
		"clean": "del-cli --verbose dist",
		"build:esm": "vite build --config vite.esm.config.ts --mode ${NODE_ENV:-development}",
		"build:tsc": "tsc --build --verbose",
		"build:cjs": "NODE_ENV=${NODE_ENV:-development}; vite build --config vite.cjs.config.ts --mode $NODE_ENV",
		"build:types": "tsc --project tsconfig.types.json",
		"test": "NODE_ENV=${NODE_ENV:-test}; pnpm exec vitest run --config ./vite.test.config.ts",
		"cli": "node ./dist/esm/cli.js"
	},
	"main": "dist/esm/index.js",
	"types": "dist/types/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/esm/index.js",
			"require": "./dist/cjs/index.cjs"
		}
	},
	"dependencies": {
		"@noble/hashes": "2.4.0",
		"@prosopo/common": "workspace:*",
		"@prosopo/logger": "workspace:*",
		"@prosopo/types": "workspace:*",
		"@prosopo/util": "workspace:*",
		"@prosopo/util-crypto": "workspace:*",
		"bcrypt": "6.0.0",
		"cli-progress": "3.12.0",
		"sharp": "0.35.5",
		"yargs": "18.2.0",
		"zod": "3.23.8"
	},
	"devDependencies": {
		"@prosopo/config": "workspace:*",
		"@types/bcrypt": "6.0.0",
		"@types/cli-progress": "3.11.6",
		"@types/node": "22.10.2",
		"@types/yargs": "17.0.35",
		"@vitest/coverage-v8": "5.0.4",
		"concurrently": "9.0.1",
		"del-cli": "6.0.0",
		"dotenv": "18.0.7",
		"npm-run-all": "4.1.5",
		"tslib": "2.7.0",
		"tsx": "4.20.3",
		"typescript": "5.6.2",
		"vite": "8.1.6",
		"vitest": "5.0.4"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/prosopo/captcha.git",
		"directory": "packages/datasets-fs"
	},
	"bugs": {
		"url": "https://github.com/prosopo/captcha/issues"
	},
	"homepage": "https://github.com/prosopo/captcha#readme",
	"publishConfig": {
		"registry": "https://registry.npmjs.org"
	},
	"description": "Datasets for use with providers",
	"directories": {
		"test": "tests"
	},
	"sideEffects": false
}
