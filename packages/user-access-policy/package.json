{
	"name": "@prosopo/user-access-policy",
	"version": "3.15.10",
	"type": "module",
	"engines": {
		"node": "^24"
	},
	"exports": {
		".": {
			"types": "./dist/types/.export.d.ts",
			"import": "./dist/esm/.export.js",
			"require": "./dist/cjs/.export.cjs"
		},
		"./api": {
			"types": "./dist/types/api/.export.d.ts",
			"import": "./dist/esm/api/.export.js",
			"require": "./dist/cjs/api/.export.cjs"
		},
		"./redis": {
			"types": "./dist/types/redis/.export.d.ts",
			"import": "./dist/esm/redis/.export.js",
			"require": "./dist/cjs/redis/.export.cjs"
		},
		"./mongoose": {
			"types": "./dist/types/mongoose/.export.d.ts",
			"import": "./dist/esm/mongoose/.export.js",
			"require": "./dist/cjs/mongoose/.export.cjs"
		}
	},
	"imports": {
		"#policy/*": {
			"types": "./dist/types/*",
			"default": "./dist/esm/*"
		}
	},
	"scripts": {
		"clean": "del-cli --verbose dist",
		"build:esm": "vite build --config vite.esm.config.ts --mode ${NODE_ENV:-development}",
		"build:tsc": "tsc --build --verbose",
		"build:cjs": "NODE_ENV=${NODE_ENV:-development}; vite build --config vite.cjs.config.ts --mode $NODE_ENV",
		"build:types": "tsc --project tsconfig.types.json",
		"test:unit": "NODE_ENV=${NODE_ENV:-test}; TEST_TYPE=unit pnpm exec vitest run --config ./vite.test.config.ts",
		"test:integration": "NODE_ENV=${NODE_ENV:-test}; TEST_TYPE=integration pnpm exec vitest run --config ./vite.test.config.ts",
		"test": "pnpm run test:unit && pnpm run test:integration"
	},
	"dependencies": {
		"@prosopo/api": "workspace:*",
		"@prosopo/api-route": "workspace:*",
		"@prosopo/common": "workspace:*",
		"@prosopo/logger": "workspace:*",
		"@prosopo/redis-client": "workspace:*",
		"@prosopo/types": "workspace:*",
		"@prosopo/util": "workspace:*",
		"@redis/search": "6.3.0",
		"cidr-calc": "1.0.4",
		"dotenv": "18.0.8",
		"ip-address": "10.7.4",
		"redis": "6.3.0",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@prosopo/config": "workspace:*",
		"@prosopo/util-crypto": "workspace:*",
		"@types/node": "22.10.2",
		"@types/yargs": "17.0.35",
		"del-cli": "6.0.0",
		"fast-glob": "3.3.3",
		"mongoose": "9.11.2",
		"typescript": "5.6.2",
		"vite": "8.1.6",
		"vitest": "5.0.4",
		"yargs": "18.2.0"
	},
	"author": "PROSOPO LIMITED <info@prosopo.io>",
	"license": "Apache-2.0",
	"bugs": {
		"url": "https://github.com/prosopo/captcha/issues"
	},
	"homepage": "https://github.com/prosopo/captcha#readme",
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/prosopo/captcha.git",
		"directory": "packages/user-access-policy"
	}
}
