{
	"name": "@prosopo/procaptcha-bundle",
	"version": "4.5.10",
	"author": "PROSOPO LIMITED <info@prosopo.io>",
	"license": "Apache-2.0",
	"main": "dist/index.js",
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": "^24"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/cjs/index.cjs"
		},
		"./components": {
			"import": "./dist/components.js",
			"require": "./dist/components.cjs"
		}
	},
	"types": "dist/index.d.ts",
	"source": "./src/index.tsx",
	"scripts": {
		"clean": "del-cli --verbose dist tsconfig.tsbuildinfo",
		"build": "pnpm run build:cross-env --mode ${NODE_ENV:-development}",
		"build:cross-env": "vite build --config vite.esm.config.ts",
		"build:tsc": "tsc --build --verbose",
		"build:cjs": "NODE_ENV=${NODE_ENV:-development}; vite build --config vite.cjs.config.ts --mode $NODE_ENV",
		"typecheck": "tsc --project tsconfig.types.json",
		"bundle": "NODE_ENV=${NODE_ENV:-development}; vite build --config vite.config.ts --mode $NODE_ENV",
		"bundle:iife": "NODE_ENV=${NODE_ENV:-development}; vite build --config vite.iife.config.ts --mode $NODE_ENV",
		"start": "NODE_ENV=${NODE_ENV:-development}; vite serve --mode $NODE_ENV --host",
		"bundle:webpack": "NODE_ENV=${NODE_ENV:-development}; MODE=${MODE:-$NODE_ENV}; webpack build --config webpack.config.cjs --mode $MODE",
		"serve": "NODE_ENV=${NODE_ENV:-development}; vite serve --config vite.serve.config.ts --mode $NODE_ENV --host",
		"test": "NODE_ENV=${NODE_ENV:-test}; pnpm exec vitest run --config ./vite.test.config.ts"
	},
	"browserslist": ["> 0.5%, last 2 versions, not dead"],
	"dependencies": {
		"@prosopo/dotenv": "workspace:*",
		"@prosopo/locale": "workspace:*",
		"@prosopo/procaptcha-common": "workspace:*",
		"@prosopo/procaptcha-frictionless": "workspace:*",
		"@prosopo/types": "workspace:*",
		"@prosopo/util": "workspace:*",
		"@prosopo/widget-skeleton": "workspace:*",
		"dotenv": "16.4.5",
		"fast-glob": "3.3.3",
		"jsdom": "25.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/prosopo/captcha.git",
		"directory": "packages/procaptcha-bundle"
	},
	"bugs": {
		"url": "https://github.com/prosopo/captcha/issues"
	},
	"homepage": "https://github.com/prosopo/captcha#readme",
	"description": "",
	"publishConfig": {
		"registry": "https://registry.npmjs.org"
	},
	"devDependencies": {
		"@polkadot/x-textdecoder": "14.0.3",
		"@polkadot/x-textencoder": "14.0.3",
		"@prosopo/config": "workspace:*",
		"@types/jsdom": "30.0.0",
		"@types/node": "22.10.2",
		"@vitest/coverage-v8": "4.1.11",
		"concurrently": "9.0.1",
		"del-cli": "6.0.0",
		"npm-run-all": "4.1.5",
		"tslib": "2.7.0",
		"tsx": "4.20.3",
		"typescript": "5.6.2",
		"vite": "8.1.5",
		"vitest": "4.1.11",
		"webpack": "5.111.1",
		"webpack-cli": "7.2.3"
	},
	"overrides": {
		"@types/react": "19.3.0"
	}
}
