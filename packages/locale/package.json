{
	"name": "@prosopo/locale",
	"version": "3.12.1",
	"description": "Prosopo locale library",
	"type": "module",
	"engines": {
		"node": "^24"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/cjs/index.cjs"
		},
		"./locales/en/translation.json": {
			"import": "./dist/locales/en/translation.json",
			"require": "./dist/locales/en/translation.json"
		},
		"./locales/en/widget.json": {
			"import": "./dist/locales/en/widget.json",
			"require": "./dist/locales/en/widget.json"
		},
		"./locales/en/target.json": {
			"import": "./dist/locales/en/target.json",
			"require": "./dist/locales/en/target.json"
		}
	},
	"scripts": {
		"clean": "del-cli --verbose dist tsconfig.tsbuildinfo",
		"build": "pnpm run build:cross-env --mode ${NODE_ENV:-development}",
		"build:cross-env": "vite build --config vite.esm.config.ts",
		"build:tsc": "tsc --build --verbose",
		"build:cjs": "NODE_ENV=${NODE_ENV:-development}; vite build --config vite.cjs.config.ts --mode $NODE_ENV",
		"typecheck": "tsc --project tsconfig.types.json",
		"test": "NODE_ENV=${NODE_ENV:-test}; pnpm exec vitest run --config ./vite.test.config.ts"
	},
	"author": "Prosopo Limited",
	"license": "Apache-2.0",
	"dependencies": {
		"@prosopo/util": "workspace:*",
		"i18next": "26.4.5",
		"i18next-fs-backend": "2.6.8",
		"i18next-http-middleware": "3.9.9"
	},
	"devDependencies": {
		"@prosopo/config": "workspace:*",
		"@types/express": "4.17.25",
		"@types/node": "22.10.2",
		"@vitest/coverage-v8": "5.0.4",
		"concurrently": "9.0.1",
		"del-cli": "6.0.0",
		"dotenv": "18.0.8",
		"express": "4.22.3",
		"npm-run-all": "4.1.5",
		"tslib": "2.7.0",
		"tsx": "4.20.3",
		"typescript": "5.6.2",
		"vite": "8.1.6",
		"vitest": "5.0.4"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/prosopo/captcha.git",
		"directory": "packages/locale"
	},
	"bugs": {
		"url": "https://github.com/prosopo/captcha/issues"
	},
	"homepage": "https://github.com/prosopo/captcha#readme",
	"publishConfig": {
		"registry": "https://registry.npmjs.org"
	},
	"sideEffects": false
}
