{
	"name": "@prosopo/provider",
	"version": "5.17.0",
	"author": "PROSOPO LIMITED <info@prosopo.io>",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": "^24"
	},
	"scripts": {
		"clean": "del-cli --verbose dist tsconfig.tsbuildinfo",
		"build": "pnpm run build:cross-env --mode ${NODE_ENV:-development}",
		"build:cross-env": "vite build --config vite.esm.config.ts",
		"build:tsc": "tsc --build --verbose",
		"build:cjs": "NODE_ENV=${NODE_ENV:-development}; vite build --config vite.cjs.config.ts --mode $NODE_ENV",
		"build:edge": "node ./scripts/buildEdgeScript.mjs",
		"typecheck": "tsc --project tsconfig.types.json",
		"test:unit": "NODE_ENV=${NODE_ENV:-test}; TEST_TYPE=unit pnpm exec vitest run --config ./vite.test.config.ts",
		"test:integration": "NODE_ENV=${NODE_ENV:-test}; TEST_TYPE=integration DECISION_MACHINE_ARTIFACT_CACHE_TTL_MS=1 pnpm exec vitest run --config ./vite.threads.test.config.ts",
		"test": "pnpm run test:unit && pnpm run test:integration",
		"mnemonic": "tsx ./scripts/generateMnemonic.ts"
	},
	"dependencies": {
		"@noble/hashes": "2.4.0",
		"@polkadot/util": "14.0.3",
		"@prosopo/api": "workspace:*",
		"@prosopo/api-express-router": "workspace:*",
		"@prosopo/api-route": "workspace:*",
		"@prosopo/audio-assets": "workspace:*",
		"@prosopo/captcha-severity": "workspace:*",
		"@prosopo/common": "workspace:*",
		"@prosopo/database": "workspace:*",
		"@prosopo/datasets": "workspace:*",
		"@prosopo/env": "workspace:*",
		"@prosopo/icon-order-assets": "workspace:*",
		"@prosopo/ipinfo": "workspace:*",
		"@prosopo/keyring": "workspace:*",
		"@prosopo/load-balancer": "workspace:*",
		"@prosopo/locale": "workspace:*",
		"@prosopo/logger": "workspace:*",
		"@prosopo/native-ja4": "workspace:*",
		"@prosopo/native-merkle": "workspace:*",
		"@prosopo/native-puzzle": "workspace:*",
		"@prosopo/puzzle-assets": "workspace:*",
		"@prosopo/redis-client": "workspace:*",
		"@prosopo/types": "workspace:*",
		"@prosopo/types-database": "workspace:*",
		"@prosopo/types-env": "workspace:*",
		"@prosopo/user-access-policy": "workspace:*",
		"@prosopo/util": "workspace:*",
		"@prosopo/util-crypto": "workspace:*",
		"@prosopo/web-bot-auth": "workspace:*",
		"cron": "3.1.7",
		"express": "4.22.2",
		"express-rate-limit": "7.4.0",
		"geolib": "3.3.14",
		"i18next": "26.4.2",
		"ip-address": "10.7.2",
		"mongoose": "9.10.3",
		"prom-client": "15.1.3",
		"uuid": "14.0.2",
		"zod": "3.23.8"
	},
	"devDependencies": {
		"@noble/curves": "2.4.0",
		"@prosopo/config": "workspace:*",
		"@types/cors": "2.8.19",
		"@types/express": "4.17.25",
		"@types/node": "22.5.5",
		"@types/pg": "8.23.1",
		"@types/uuid": "11.0.0",
		"@vitest/coverage-v8": "4.1.11",
		"@vitest/spy": "4.1.11",
		"concurrently": "9.0.1",
		"cors": "2.8.6",
		"del-cli": "6.0.0",
		"dotenv": "16.4.5",
		"esbuild": "0.28.2",
		"npm-run-all": "4.1.5",
		"testcontainers": "12.2.0",
		"tslib": "2.7.0",
		"tsx": "4.20.3",
		"typescript": "5.6.2",
		"undici": "6.29.0",
		"vite": "8.1.5",
		"vitest": "4.1.11"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/prosopo/captcha.git",
		"directory": "packages/provider"
	},
	"description": "The easiest way to deploy the Prosopo contract and run the Provider node is via the [captcha repository](https://github.com/prosopo/captcha/).",
	"bugs": {
		"url": "https://github.com/prosopo/captcha/issues"
	},
	"homepage": "https://github.com/prosopo/captcha#readme",
	"sideEffects": false,
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/cjs/index.cjs"
		}
	}
}
