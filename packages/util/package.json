{
	"name": "@prosopo/util",
	"version": "3.3.17",
	"author": "PROSOPO LIMITED <info@prosopo.io>",
	"license": "Apache-2.0",
	"private": false,
	"engines": {
		"node": "^24"
	},
	"scripts": {
		"clean": "del-cli --verbose dist",
		"build:esm": "vite build --config vite.esm.config.ts --mode ${NODE_ENV:-development}",
		"build:tsc": "tsc --build --verbose",
		"build:cjs": "NODE_ENV=${NODE_ENV:-development}; vite build --config vite.cjs.config.ts --mode $NODE_ENV",
		"build:types": "tsc --project tsconfig.types.json",
		"cli": "node ./dist/esm/js/cli.js",
		"test": "NODE_ENV=${NODE_ENV:-test}; pnpm exec vitest run --config ./vite.test.config.ts"
	},
	"main": "dist/esm/index.js",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/esm/index.js",
			"require": "./dist/cjs/index.cjs"
		},
		"./lodash": {
			"types": "./dist/types/lodash.d.ts",
			"import": "./dist/esm/lodash.js",
			"require": "./dist/cjs/lodash.cjs",
			"default": "./dist/esm/lodash.js"
		},
		"./node": {
			"types": "./dist/types/node.d.ts",
			"import": "./dist/esm/node.js",
			"require": "./dist/cjs/node.cjs",
			"default": "./dist/esm/node.js"
		}
	},
	"types": "dist/types/index.d.ts",
	"dependencies": {
		"@noble/hashes": "2.4.0",
		"ip-address": "10.7.4",
		"lodash": "4.18.1",
		"seedrandom": "3.0.5",
		"url": "0.11.4"
	},
	"devDependencies": {
		"@prosopo/config": "workspace:*",
		"@types/lodash": "4.17.26",
		"@types/node": "22.10.2",
		"@types/seedrandom": "3.0.8",
		"@vitest/coverage-v8": "5.0.4",
		"concurrently": "9.0.1",
		"del-cli": "6.0.0",
		"dotenv": "18.0.7",
		"npm-run-all": "4.1.5",
		"tslib": "2.7.0",
		"tsx": "4.20.3",
		"typescript": "5.6.2",
		"vite": "8.1.6",
		"vitest": "5.0.4"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/prosopo/captcha.git",
		"directory": "packages/util"
	},
	"bugs": {
		"url": "https://github.com/prosopo/captcha/issues"
	},
	"homepage": "https://github.com/prosopo/captcha#readme",
	"publishConfig": {
		"registry": "https://registry.npmjs.org"
	},
	"description": "Utility package to house all code that is not specific to prosopo. E.g. random number generation, string manipulation, etc.",
	"sideEffects": false
}
