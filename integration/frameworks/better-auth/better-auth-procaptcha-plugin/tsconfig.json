{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./dist/tsc",
		"tsBuildInfoFile": "./dist/tsc/tsconfig.tsbuildinfo",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"target": "ES2022",
		"lib": ["es2022", "dom"]
	},
	"include": [
		"./src",
		"src/**/*.ts",
		"src/**/*.tsx",
		"src/**/*.json",
		"src/**/*.d.ts"
	],
	"references": [
		{
			"path": "../../../../dev/config/tsconfig.json"
		},
		{
			"path": "../../../../packages/types"
		}
	]
}
