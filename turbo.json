{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": [
		"**/.env.*",
		"package.json",
		"pnpm-lock.yaml",
		"tsconfig.json",
		"tsconfig.*.json",
		"vite.config.*",
		"vite.*.config.*"
	],
	"globalEnv": ["NODE_ENV"],
	"ui": "tui",
	"concurrency": "100%",
	"daemon": false,
	"envMode": "loose",
	"tasks": {
		// Each build variant writes only its own dist/<variant> dir, so turbo can
		// cache and restore every variant on its own. `build` is the aggregate a
		// package needs at runtime: its ESM, its declarations and, for the napi
		// packages, the native addon.
		"build": {
			"dependsOn": ["^build", "build:esm", "build:types", "build:native"],
			"outputs": []
		},
		"build:esm": {
			"dependsOn": ["^build:esm", "@prosopo/config#build"],
			"outputs": ["dist/esm/**"]
		},
		"build:types": {
			"dependsOn": ["^build:types"],
			"outputs": ["dist/types/**"]
		},
		// Workspace dependencies resolve through `exports.types`, which is
		// dist/types, not the dist/tsc this task emits.
		"build:tsc": {
			"dependsOn": ["^build:tsc", "^build:types"],
			"outputs": ["dist/tsc/**"]
		},
		"build:cjs": {
			"dependsOn": ["^build:cjs", "@prosopo/config#build"],
			"outputs": ["dist/cjs/**"]
		},
		// Debug builds unless NODE_ENV=production; NODE_ENV is a global env var,
		// so the two profiles are cached apart.
		"build:native": {
			"dependsOn": ["^build:native"],
			"outputs": ["dist/native/**"]
		},
		// The cli bundle copies the native addons in beside itself.
		"bundle": {
			"dependsOn": ["@prosopo/config#build", "^build:native"],
			"outputs": ["dist/bundle/**", "!dist/bundle/procaptcha.bundle.iife.js*"]
		},
		// Image builds copy dist/bundle out of the build context, so they wait on
		// the bundle task. Not cached: the artefact is an image in the docker
		// daemon's store rather than a file under the package, so turbo cannot
		// restore it on a cache hit — and a false hit would silently skip a
		// rebuild the registry never received.
		"build:docker": {
			"dependsOn": ["bundle"],
			"cache": false
		},
		// The provider image is built from packages/cli, but its context is the
		// repo root and it also copies packages/locale's compiled locales.
		"@prosopo/cli#build:docker": {
			"dependsOn": ["bundle", "@prosopo/locale#build"],
			"cache": false
		},
		// Every image in one bake invocation, run through turbo so the bundles
		// each image copies are built first. It is a root task rather than a
		// package one because bake drives the whole repo at once; the per-package
		// build:docker tasks above stay the way to build a single image.
		//
		// Deliberately not named build:docker: `turbo run build:docker` would
		// then match both this and every package task, and every image would be
		// built twice.
		"//#build:docker:all": {
			"dependsOn": [
				"@prosopo/cli#bundle",
				"@prosopo/client-example-server#bundle",
				"@prosopo/provider-mock#bundle",
				"@prosopo/locale#build"
			],
			"cache": false
		},
		"publish:docker": {
			"dependsOn": ["build:docker"],
			"cache": false
		},
		// The IIFE fallback ships beside the ESM bundle, from the same folder the
		// deployer uploads, so it shares dist/bundle and owns only its own files.
		// It runs after `bundle`, which empties dist/bundle before writing.
		"bundle:iife": {
			"dependsOn": ["@prosopo/config#build", "bundle"],
			"outputs": ["dist/bundle/procaptcha.bundle.iife.js*"]
		},
		"bundle:webpack": {
			"dependsOn": ["@prosopo/config#build"],
			"outputs": ["dist/bundle-webpack/**"]
		},
		"typecheck": {
			"dependsOn": ["build:types"]
		},
		"test": {
			// Tests resolve workspace dependencies through their package exports,
			// so they need each dependency's dist/esm and dist/types (^build); the
			// napi packages' own tests load their own addon.
			"dependsOn": ["@prosopo/config#build", "^build", "build:native"]
		},
		"lint": { "dependsOn": ["^lint"] },
		"clean": {
			"cache": false
		},
		"clean:deps": {
			"dependsOn": ["clean", "^clean"],
			"cache": false
		}
	},
	"remoteCache": {
		"enabled": false
	}
}
