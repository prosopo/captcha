{
	"name": "@prosopo/vector-docker",
	"version": "3.1.4",
	"engines": {
		"node": "^24",
		"npm": "^11"
	},
	"type": "module",
	"scripts": {
		"clean": "del-cli --verbose dist tsconfig.tsbuildinfo",
		"docker-tag": "node ../../docker-tag.mjs",
		"build:docker": "pnpm run clean && cp -r src dist && docker buildx build --progress=plain --tag $(pnpm run --silent docker-tag) --platform linux/amd64 -f ./dist/Dockerfile ./dist",
		"publish:docker": "docker push $(pnpm run --silent docker-tag)",
		"test": "node --test scripts/vector-test.test.mjs && node scripts/vector-test.mjs",
		"test:negative": "node scripts/vector-test.mjs --negative"
	},
	"devDependencies": {
		"@prosopo/config": "workspace:*"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/prosopo/captcha.git",
		"directory": "docker/images/vector"
	},
	"private": true
}
