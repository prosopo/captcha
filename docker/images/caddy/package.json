{
	"name": "@prosopo/caddy-docker",
	"version": "2.5.9",
	"engines": {
		"node": "^24",
		"npm": "^11"
	},
	"type": "module",
	"scripts": {
		"clean": "del-cli --verbose dist tsconfig.tsbuildinfo",
		"docker-tag": "node ../../docker-tag.mjs",
		"build:docker": "npm run clean && cp -r src dist && docker buildx build --progress=plain --tag $(npm run --silent docker-tag) --platform linux/amd64 -f ./dist/Dockerfile ./dist",
		"publish:docker": "docker push $(npm run --silent docker-tag)"
	},
	"devDependencies": {
		"@prosopo/config": "3.1.20"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/prosopo/captcha.git",
		"directory": "docker/images/caddy"
	},
	"private": true
}
