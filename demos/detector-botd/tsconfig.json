{
	"extends": "../../tsconfig.esm.json",
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./dist/tsc",
		"tsBuildInfoFile": "./dist/tsc/tsconfig.tsbuildinfo",
		"module": "NodeNext",
		"lib": ["es2022", "dom"]
	},
	"include": [
		"src",
		"src/**/*.json",
		"src/**/*.ts",
		"src/**/*.tsx",
		"src/**/*.d.ts"
	],
	"references": [
		{
			"path": "../../packages/procaptcha-frictionless"
		},
		{
			"path": "../../packages/provider"
		},
		{
			"path": "../../packages/types"
		}
	]
}
