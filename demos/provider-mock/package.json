{
	"name": "@prosopo/provider-mock",
	"version": "2.8.214",
	"author": "PROSOPO LIMITED <info@prosopo.io>",
	"license": "Apache-2.0",
	"type": "module",
	"main": "dist/esm/index.js",
	"types": "dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/esm/index.js",
			"require": "./dist/cjs/index.cjs"
		}
	},
	"engines": {
		"node": "^24"
	},
	"scripts": {
		"build:esm": "vite build --config vite.esm.config.ts --mode ${NODE_ENV:-development}",
		"build:tsc": "tsc --build --verbose",
		"build:cjs": "NODE_ENV=${NODE_ENV:-development}; vite build --config vite.cjs.config.ts --mode $NODE_ENV",
		"docker-tag": "node ../../docker/docker-tag.mjs",
		"build:docker": "docker buildx build --progress=plain --tag $(pnpm run --silent docker-tag) --platform linux/amd64 -f ./Dockerfile ../..",
		"publish:docker": "docker push $(pnpm run --silent docker-tag)",
		"build:types": "tsc --project tsconfig.types.json",
		"bundle": "NODE_ENV=${NODE_ENV:-development}; vite build --config vite.config.ts --mode $NODE_ENV",
		"test": "NODE_ENV=${NODE_ENV:-test}; pnpm exec vitest run --config ./vite.test.config.ts",
		"test:watch": "NODE_ENV=${NODE_ENV:-test}; pnpm exec vitest --config ./vite.test.config.ts",
		"test:coverage": "NODE_ENV=${NODE_ENV:-test}; pnpm exec vitest run --coverage --config ./vite.test.config.ts"
	},
	"dependencies": {
		"@prosopo/api-express-router": "workspace:*",
		"@prosopo/common": "workspace:*",
		"@prosopo/logger": "workspace:*",
		"@prosopo/database": "workspace:*",
		"@prosopo/dotenv": "workspace:*",
		"@prosopo/locale": "workspace:*",
		"@prosopo/provider": "workspace:*",
		"@prosopo/types": "workspace:*",
		"@prosopo/types-database": "workspace:*",
		"cors": "2.8.6",
		"express": "4.22.3",
		"express-rate-limit": "7.4.0",
		"mongoose": "9.11.2"
	},
	"devDependencies": {
		"@prosopo/config": "workspace:*",
		"@types/cors": "2.8.19",
		"@types/express": "4.17.25",
		"@types/node": "22.10.2",
		"@vitest/coverage-v8": "5.0.4",
		"concurrently": "9.0.1",
		"del-cli": "6.0.0",
		"dotenv": "18.0.8",
		"npm-run-all": "4.1.5",
		"tslib": "2.7.0",
		"tsx": "4.20.3",
		"typescript": "5.6.2",
		"vite": "8.1.6",
		"vitest": "5.0.4"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/prosopo/captcha.git",
		"directory": "demos/provider-mock"
	},
	"bugs": {
		"url": "https://github.com/prosopo/captcha/issues"
	},
	"homepage": "https://github.com/prosopo/captcha#readme",
	"sideEffects": false
}
